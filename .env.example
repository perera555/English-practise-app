# Copy this file to .env.local (local) and add the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets. .env.local is ignored by git.

# --- AI robot (Claude) ---
ANTHROPIC_API_KEY=
# Set to true only for testing: lets everyone use the AI robot without Premium.
FREE_AI=false

# --- Admin dashboard (/admin) ---
# At least 8 characters. Anyone with this password can manage users and content.
ADMIN_PASSWORD=

# --- Database for admin content, gift codes and grants (Upstash Redis, free tier) ---
# Vercel → Storage → Marketplace → Upstash Redis fills these in automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- RevenueCat (subscriptions on Google Play + App Store) ---
# Secret key (server only): RevenueCat → Project settings → API keys → Secret API key
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=premium
# Public SDK keys (safe to be in the app)
NEXT_PUBLIC_RC_ANDROID_KEY=
NEXT_PUBLIC_RC_IOS_KEY=
NEXT_PUBLIC_RC_ENTITLEMENT=premium

# --- Phone app ---
# Your hosted website. The phone app sends AI chat / premium checks / content downloads here.
NEXT_PUBLIC_API_BASE=https://your-site.vercel.app
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
